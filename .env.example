# Supabase 프로젝트 설정 → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=<publishable 또는 anon key>

# types/db.ts 생성용 (npm run gen:types:db). Supabase CLI 를 쓸 수 있으면 불필요.
# 로컬 supabase start 기본값: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 관리자 기능(계정 생성·비밀번호 초기화)에만 서버에서 사용. 절대 NEXT_PUBLIC_ 붙이지 말 것.
# Supabase → Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
